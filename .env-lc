# Environment variables for local development only
# For Kubernetes deployment, use configmap.yaml and secrets.yaml instead

# Application Configuration
SPRING_APPLICATION_NAME=spring-boot-template
SPRING_PROFILES_ACTIVE=develop
LOG_STARTUP_INFO=false
SPRING_LIQUIBASE_ENABLED=true

# Database Configuration (Non-sensitive)
SPRING_DATASOURCE_JDBC=jdbc:postgresql
SPRING_DATASOURCE_HOST=host.docker.internal
SPRING_DATASOURCE_PORT=5432
SPRING_DATASOURCE_NAME=spring-boot-template

# Database Credentials (Sensitive - use secrets.yaml in K8s)
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# JPA Configuration
HIBERNATE_DDL_AUTO=none
SHOW_SQL=false
OPEN_IN_VIEW=false

# Server Configuration
SHOW_ACTUATOR=true
SERVER_PORT=8080

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_FILE_PATH=app
LOGGING_FILE_NAME=app/file.log

# Management Endpoints
INCLUDE=*
SHOW_DETAILS=always